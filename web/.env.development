# Local/hosted development defaults (loaded by `next dev`).
#
# Live mode (0): the app calls /api/*, which reaches the FastAPI backend either
# through the Next rewrite (local: API_PROXY_TARGET, default http://127.0.0.1:8000)
# or through the host's ingress (e.g. Emergent routes /api/* to the backend).
# The backend serves every route under /api as well as /.
#
# Set to 1 only for a backend-less static demo that reads web/public/api-static.
NEXT_PUBLIC_STATIC_DATA=0
