# Server settings. install.sh copies this to /etc/mit/mit.env (never committed).
# After editing /etc/mit/mit.env:  sudo systemctl restart mit-api

# Your domain, without https:// or www (e.g. example.com)
DOMAIN=example.com
# Email for Let's Encrypt certificate notices
ACME_EMAIL=you@example.com

# Data lives on the server's disk and survives restarts and updates
COMPETE_DATA_DIR=/var/lib/mit
COMPETE_DUCKDB_PATH=/var/lib/mit/compete.duckdb

# Public-site safety: visitors can explore and run analyses (rate-limited);
# only the owner (with this token) can change AI keys, companies or the pipeline.
COMPETE_PUBLIC_MODE=true
COMPETE_ADMIN_TOKEN=change-me
COMPETE_MAX_CONCURRENT_RUNS=2

# Free defaults: no AI key needed
COMPETE_RESEARCH_PROVIDER=open
COMPETE_LLM_PROVIDER=mock
COMPETE_CORS_ORIGINS=https://example.com

# Optional: an owner key that gives every visitor AI analysis (e.g. Groq free tier)
# OPERATOR_LLM_BASE_URL=https://api.groq.com/openai/v1
# OPERATOR_LLM_MODEL=llama-3.3-70b-versatile
# OPERATOR_LLM_API_KEY=
