# Copy to deploy/.env (install.sh does this for you). Never commit deploy/.env.

# Your domain, without https:// or www (e.g. example.com)
DOMAIN=example.com
# Email for Let's Encrypt certificate notices
ACME_EMAIL=you@example.com

# Public-site safety (implemented by docs/PUBLIC_DEPLOY_PROMPT.md)
COMPETE_PUBLIC_MODE=true
# Long random string; only you use it to change server-wide LLM settings
COMPETE_ADMIN_TOKEN=change-me
COMPETE_MAX_CONCURRENT_RUNS=2

# Free defaults: no AI key needed. Visitors can bring their own key per session.
COMPETE_RESEARCH_PROVIDER=open
COMPETE_LLM_PROVIDER=mock

# Optional: an operator key that gives every visitor AI by default (e.g. Groq free tier)
# OPERATOR_LLM_BASE_URL=https://api.groq.com/openai/v1
# OPERATOR_LLM_MODEL=llama-3.3-70b-versatile
# OPERATOR_LLM_API_KEY=
